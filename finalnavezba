7. SQLiteHelper.java

java
package com.example.kolokvijum2;

import android.content.Context;
import android.database.sqlite.SQLiteDatabase;
import android.database.sqlite.SQLiteOpenHelper;

public class SQLiteHelper extends SQLiteOpenHelper {

    public static final String TABLE_ROLES = "ROLES";
    public static final String COLUMN_ID = "id";
    public static final String COLUMN_NAME = "name";
    public static final String COLUMN_DESCRIPTION = "description";

    private static final String DATABASE_NAME = "uloge.db";
    private static final int DATABASE_VERSION = 1;

    private static final String DB_CREATE = "create table "
            + TABLE_ROLES + "("
            + COLUMN_ID + " integer primary key, "
            + COLUMN_NAME + " text, "
            + COLUMN_DESCRIPTION + " text"
            + ")";

    public SQLiteHelper(Context context) {
        super(context, DATABASE_NAME, null, DATABASE_VERSION);
    }

    @Override
    public void onCreate(SQLiteDatabase db) {
        db.execSQL(DB_CREATE);
    }

    @Override
    public void onUpgrade(SQLiteDatabase db, int oldVersion, int newVersion) {
        db.execSQL("DROP TABLE IF EXISTS " + TABLE_ROLES);
        onCreate(db);
    }
}



8. MainActivity.java

java
package com.example.kolokvijum2;

import android.content.ContentValues;
import android.content.Intent;
import android.database.sqlite.SQLiteDatabase;
import android.graphics.Bitmap;
import android.graphics.BitmapFactory;
import android.hardware.Sensor;
import android.hardware.SensorEvent;
import android.hardware.SensorEventListener;
import android.hardware.SensorManager;
import android.net.Uri;
import android.os.Bundle;
import android.provider.MediaStore;
import android.widget.Button;
import android.widget.CheckBox;
import android.widget.ImageView;
import android.widget.TextView;
import android.widget.Toast;
import androidx.activity.result.ActivityResultLauncher;
import androidx.activity.result.contract.ActivityResultContracts;
import androidx.appcompat.app.AppCompatActivity;
import androidx.core.content.FileProvider;

import java.io.File;
import java.util.List;

import retrofit2.Call;
import retrofit2.Callback;
import retrofit2.Response;

public class MainActivity extends AppCompatActivity implements SensorEventListener {

    private TextView tvProximity, tvSecond;
    private Button button;
    private ImageView imageView;
    private CheckBox checkBox1, checkBox2;

    private SensorManager sensorManager;
    private Sensor proximitySensor;

    private SQLiteHelper helper;

    private ActivityResultLauncher<Intent> kameraLauncher;
    private File photoFile;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        tvProximity = findViewById(R.id.tvProximity);
        tvSecond = findViewById(R.id.tvSecond);
        button = findViewById(R.id.button);
        imageView = findViewById(R.id.imageView);
        checkBox1 = findViewById(R.id.checkBox1);
        checkBox2 = findViewById(R.id.checkBox2);

        helper = new SQLiteHelper(this);

        
        sensorManager = (SensorManager) getSystemService(SENSOR_SERVICE);
        proximitySensor = sensorManager.getDefaultSensor(Sensor.TYPE_PROXIMITY);

        
        kameraLauncher = registerForActivityResult(
                new ActivityResultContracts.StartActivityForResult(),
                result -> {
                    if (result.getResultCode() == RESULT_OK && photoFile != null) {
                        
                        Bitmap bmp = BitmapFactory.decodeFile(photoFile.getAbsolutePath());
                        imageView.setImageBitmap(bmp);
                    }
                });

      
        button.setOnClickListener(v -> pokreniKameru());

        
        checkBox1.setOnCheckedChangeListener((buttonView, isChecked) -> {
            if (isChecked) {
                fetchRoles();
            }
        });
    }

    
    private void pokreniKameru() {
        photoFile = new File(getFilesDir(), "slika.jpg");
        Uri photoUri = FileProvider.getUriForFile(this,
                getPackageName() + ".fileprovider", photoFile);

        Intent intent = new Intent(MediaStore.ACTION_IMAGE_CAPTURE);
        intent.putExtra(MediaStore.EXTRA_OUTPUT, photoUri);
        intent.addFlags(Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
        kameraLauncher.launch(intent);
    }

    
    private void fetchRoles() {
        ClientUtils.apiService.getRoles().enqueue(new Callback<List<Role>>() {
            @Override
            public void onResponse(Call<List<Role>> call, Response<List<Role>> response) {
                if (response.isSuccessful() && response.body() != null) {
                    SQLiteDatabase db = helper.getWritableDatabase();
                    db.delete(SQLiteHelper.TABLE_ROLES, null, null); // ocisti da nema duplikata
                    int sacuvano = 0;
                    for (Role r : response.body()) {
                        if (r.id % 2 == 0) {   // samo paran ID
                            ContentValues values = new ContentValues();
                            values.put(SQLiteHelper.COLUMN_ID, r.id);
                            values.put(SQLiteHelper.COLUMN_NAME, r.name);
                            values.put(SQLiteHelper.COLUMN_DESCRIPTION, r.description);
                            db.insert(SQLiteHelper.TABLE_ROLES, null, values);
                            sacuvano++;
                        }
                    }
                    db.close();
                    Toast.makeText(MainActivity.this, "Sacuvano " + sacuvano + " uloga", Toast.LENGTH_SHORT).show();
                }
            }
            @Override
            public void onFailure(Call<List<Role>> call, Throwable t) {
                Toast.makeText(MainActivity.this, "Greska: " + t.getMessage(), Toast.LENGTH_SHORT).show();
            }
        });
    }

    
    @Override
    public void onSensorChanged(SensorEvent event) {
        if (event.sensor.getType() == Sensor.TYPE_PROXIMITY) {
            float vrednost = event.values[0];
            tvProximity.setText("Proximity: " + vrednost);

            float prag = 3;
            if (vrednost > prag) {   // IZNAD praga -> Daleko!
                Toast.makeText(this, "Daleko!", Toast.LENGTH_SHORT).show();
            }
        }
    }

    @Override
    public void onAccuracyChanged(Sensor sensor, int accuracy) {}

    @Override
    protected void onResume() {
        super.onResume();
        sensorManager.registerListener(this, proximitySensor, SensorManager.SENSOR_DELAY_NORMAL);
    }

    @Override
    protected void onPause() {
        super.onPause();
        sensorManager.unregisterListener(this);
    }
}


